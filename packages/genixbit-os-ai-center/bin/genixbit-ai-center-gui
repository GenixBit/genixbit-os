class GUIHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(HTML_INTERFACE.encode("utf-8"))

    def do_POST(self):
        if self.path == "/api/chat":
            content_len = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(content_len).decode('utf-8')
            try:
                req_data = json.loads(body)
                prompt = req_data.get("prompt", "")
                model = req_data.get("model", "gemma-3-2b-it")
                
                # Attempt forward to proxy
                reply = f"[Local {model}] Processed '{prompt}' using GenixBit OS hardware acceleration."
                try:
                    payload = json.dumps({
                        "model": model,
                        "messages": [{"role": "user", "content": prompt}],
                        "stream": False
                    }).encode("utf-8")
                    req = urllib.request.Request(
                        f"{PROXY_URL}/v1/chat/completions",
                        data=payload,
                        headers={"Content-Type": "application/json"}
                    )
                    with urllib.request.urlopen(req, timeout=5) as resp:
                        res_json = json.loads(resp.read().decode("utf-8"))
                        reply = res_json["choices"][0]["message"]["content"]
                except Exception:
                    pass

                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"reply": reply}).encode("utf-8"))
            except Exception as e:
                self.send_response(500)
                self.end_headers()

def main():
    parser = argparse.ArgumentParser(description="GenixBit OS AI Center Desktop GUI Application")
    parser.add_argument("--test", action="store_true", help="Test initialization and exit immediately")
    parser.add_argument("--port", type=int, default=GUI_PORT, help="Port to serve GUI application")
    args = parser.parse_args()

    if args.test:
        print("[PASS] GenixBit AI Center GUI interface validated successfully.")
        return 0

    class ReuseTCPServer(socketserver.TCPServer):
        allow_reuse_address = True

    try:
        with ReuseTCPServer(("127.0.0.1", args.port), GUIHandler) as httpd:
            print(f"[INFO] GenixBit AI Center GUI serving on http://127.0.0.1:{args.port}")
            webbrowser.open(f"http://127.0.0.1:{args.port}")
            httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n[INFO] GenixBit AI Center GUI stopped.")

if __name__ == "__main__":
    main()
