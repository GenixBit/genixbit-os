#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
import sys

# Try installed path first, then local source path
INSTALLED_GUI = "/usr/lib/genixbit-os/ai_center_gui.py"
LOCAL_GUI = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "usr", "lib", "genixbit-os", "ai_center_gui.py")

if os.path.exists(INSTALLED_GUI):
    sys.path.insert(0, "/usr/lib/genixbit-os")
    import ai_center_gui
    ai_center_gui.launch_gui()
elif os.path.exists(LOCAL_GUI):
    sys.path.insert(0, os.path.dirname(LOCAL_GUI))
    import ai_center_gui
    ai_center_gui.launch_gui()
else:
    print("[AI Center] GUI module not found, launching CLI mode.")
    os.system("genixbit-ai-center --help")
