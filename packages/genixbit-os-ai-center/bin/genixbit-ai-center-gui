import http.server
import json
import os
import socketserver
import sys
import threading
import time
import urllib.request
import webbrowser

PROXY_URL = os.environ.get("GENIXBIT_AI_PROXY_URL", "http://127.0.0.1:11434")
GUI_PORT = 11438

HTML_INTERFACE = """<!DOCTYPE html>
