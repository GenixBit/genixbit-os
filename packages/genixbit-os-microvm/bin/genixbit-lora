#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# GenixBit OS — genixbit-lora CLI
import argparse
import json
import os
import sys

for p in ["/usr/lib/genixbit-os", os.path.join(os.path.dirname(__file__), "../usr/lib/genixbit-os")]:
    if os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

import lora_manager

def main():
    parser = argparse.ArgumentParser(description="GenixBit Dynamic LoRA Adapter Manager")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # list
    list_p = subparsers.add_parser("list", help="List registered LoRA adapters")
    list_p.add_argument("--json", action="store_true", help="Output as JSON")

    # swap
    swap_p = subparsers.add_parser("swap", help="Hot-swap active LoRA adapter on running model")
    swap_p.add_argument("adapter_id", help="Adapter ID to activate")

    args = parser.parse_args()

    if args.command == "swap":
        res = lora_manager.swap_adapter(args.adapter_id)
        print(json.dumps(res, indent=2))
    else:
        adapters = lora_manager.list_active_adapters()
        if getattr(args, "json", False):
            print(json.dumps({"adapters": adapters}, indent=2))
        else:
            print("============================================================")
            print("        GenixBit Registered LoRA Adapters                   ")
            print("============================================================")
            for a in adapters:
                print(f"[{a['status'].upper()}] {a['id']:<20} Base: {a['base_model']:<15} Task: {a['task']}")

if __name__ == "__main__":
    main()
