#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# GenixBit OS — genixbit-guard CLI
import argparse
import json
import os
import sys

for p in ["/usr/lib/genixbit-os", os.path.join(os.path.dirname(__file__), "../usr/lib/genixbit-os")]:
    if os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

import agent_guard

def main():
    parser = argparse.ArgumentParser(description="GenixBit Autonomous Agent Security Guard")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # audit
    audit_p = subparsers.add_parser("audit", help="Audit a shell command or script for security risks")
    audit_p.add_argument("cmd_args", nargs="+", help="Command to audit")

    # scan
    scan_p = subparsers.add_parser("scan", help="Scan text/file for leaked private keys or API secrets")
    scan_p.add_argument("target", help="File path or text string to scan")

    # status
    subparsers.add_parser("status", help="Show active security guard enforcement policy")

    args = parser.parse_args()

    if args.command == "audit":
        cmd_str = " ".join(args.cmd_args)
        res = agent_guard.audit_command(cmd_str)
        print(json.dumps(res, indent=2))
        if not res["allowed"]:
            sys.exit(1)
    elif args.command == "scan":
        content = args.target
        if os.path.exists(args.target):
            with open(args.target, "r", errors="ignore") as f:
                content = f.read()
        res = agent_guard.scan_for_secrets(content)
        print(json.dumps(res, indent=2))
    else:
        print("GenixBit Agent Security Guard — Policy Enforcement Active (Level: STRICT).")

if __name__ == "__main__":
    main()
