# GenixBit OS Local AI Proxy & Model Runtime Service

import http.server
import json
import os
import socketserver
import sys

PORT = 11434
CATALOG_PATH = "/usr/share/genixbit-os/models/catalog.json"

class GenixBitAIProxyHandler(http.server.BaseHTTPRequestHandler):
    def _send_json(self, data, status=200):
        body = json.dumps(data, indent=2).encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Headers', '*')
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path in ('/health', '/v1/health'):
            self._send_json({"status": "ok", "service": "genixbit-ai-proxy", "version": "0.5.0-alpha"})
        elif self.path in ('/v1/models', '/api/tags'):
            if os.path.exists(CATALOG_PATH):
                with open(CATALOG_PATH, 'r', encoding='utf-8') as f:
                    cat = json.load(f)
                models_list = [{"id": m["id"], "object": "model", "owned_by": "genixbit-os"} for m in cat.get("models", [])]
                self._send_json({"object": "list", "data": models_list})
            else:
                self._send_json({"object": "list", "data": []})
        else:
            self._send_json({"error": "Endpoint not found"}, status=404)

    def do_POST(self):
        if self.path in ('/v1/chat/completions', '/api/generate'):
            content_length = int(self.headers.get('Content-Length', 0))
            post_data = self.rfile.read(content_length)
            try:
                payload = json.loads(post_data.decode('utf-8'))
            except Exception:
                payload = {}
            model = payload.get("model", "gemma-3-2b-it")
            response = {
                "id": "genixbit-chatcmpl-001",
                "object": "chat.completion",
                "created": 1785950000,
                "model": model,
                "choices": [{
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": f"[GenixBit OS AI Runtime] Service online. Model '{model}' ready for local acceleration."
                    },
                    "finish_reason": "stop"
                }],
                "usage": {"prompt_tokens": 12, "completion_tokens": 18, "total_tokens": 30}
            }
            self._send_json(response)
        else:
            self._send_json({"error": "Endpoint not found"}, status=404)

def main():
    print(f"[INFO] Starting GenixBit OS AI Proxy on port {PORT}...")
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", PORT), GenixBitAIProxyHandler) as httpd:
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\n[INFO] GenixBit OS AI Proxy stopped.")

if __name__ == "__main__":
    main()
