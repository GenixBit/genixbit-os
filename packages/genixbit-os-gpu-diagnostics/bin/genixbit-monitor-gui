class MonitorHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(HTML_INTERFACE.encode("utf-8"))

    def log_message(self, format, *args):
        pass

def main():
    parser = argparse.ArgumentParser(description="GenixBit OS AI Hardware & System Monitor GUI")
    parser.add_argument("--port", type=int, default=GUI_PORT, help="Port to run GUI server on")
    parser.add_argument("--no-browser", action="store_true", help="Do not auto-launch web browser")
    args = parser.parse_args()

    port = args.port
    server = None
    for attempt in range(5):
        try:
            server = socketserver.TCPServer(("127.0.0.1", port), MonitorHandler)
            break
        except OSError:
            port += 1

    if not server:
        print(f"[ERROR] Could not bind GenixBit Monitor GUI to port {args.port} or next 5 ports.")
        sys.exit(1)

    url = f"http://127.0.0.1:{port}"
    print(f"[GenixBit Monitor GUI] Active at {url}")

    if not args.no_browser:
        threading.Thread(target=lambda: (time.sleep(0.4), webbrowser.open(url)), daemon=True).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[GenixBit Monitor GUI] Stopped.")
        server.server_close()

if __name__ == "__main__":
    main()
