# GenixBit OS Agents Integration CLI Bridge
# Connects developer workstations to Google Antigravity SDK, Gemini CLI, Cursor, Codex & OpenCode.
# Features: Agent doctor diagnostics, offline local code semantic search & vector indexer.

import argparse
import glob
import json
import math
import os
import shutil
import sys
import time
import urllib.error
import urllib.request

PROXY_URL = os.environ.get("GENIXBIT_AI_PROXY_URL", "http://127.0.0.1:11434")

AGENTS_REGISTRY = [
    {
        "name": "antigravity",
        "title": "Google Antigravity Agentic IDE & SDK",
        "binary": "agy",
        "env_var": "ANTIGRAVITY_API_BASE",
        "default_endpoint": f"{PROXY_URL}/v1",
        "description": "Google Antigravity autonomous multi-agent coding framework and IDE agent.",
        "config_path": "~/.gemini/antigravity"
    },
    {
        "name": "gemini-cli",
        "title": "Gemini CLI Agent",
        "binary": "gemini",
        "env_var": "GEMINI_API_BASE",
        "default_endpoint": f"{PROXY_URL}/v1",
        "description": "Google Gemini CLI developer assistant agent for terminal workflows.",
        "config_path": "~/.gemini"
    },
    {
        "name": "cursor",
        "title": "Cursor Agentic Coding Bridge",
        "binary": "cursor",
        "env_var": "OPENAI_BASE_URL",
        "default_endpoint": f"{PROXY_URL}/v1",
        "description": "Cursor AI IDE integration bridge connecting editor to local model acceleration.",
        "config_path": "~/.config/Cursor"
    },
    {
        "name": "codex",
        "title": "OpenAI Codex / Code Agent",
        "binary": "codex",
        "env_var": "OPENAI_API_BASE",
        "default_endpoint": f"{PROXY_URL}/v1",
        "description": "Standardized OpenAI-compatible code assistant agent.",
        "config_path": "~/.config/codex"
    },
    {
        "name": "opencode",
        "title": "OpenCode Studio Agent",
        "binary": "opencode",
        "env_var": "OPENCODE_MODEL_ENDPOINT",
        "default_endpoint": f"{PROXY_URL}/v1",
        "description": "Open-source developer agent studio for pair programming and refactoring.",
        "config_path": "~/.config/opencode"
    }
]

def check_proxy_health():
    """Verify local AI proxy status."""
    try:
        req = urllib.request.Request(f"{PROXY_URL}/health", headers={"User-Agent": "genixbit-agent/1.0"})
        with urllib.request.urlopen(req, timeout=2) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return True, data
    except Exception as e:
        return False, str(e)

def list_agents():
    print("============================================================")
    print("            GenixBit OS Integrated Agent Registry           ")
    print("============================================================")
    for a in AGENTS_REGISTRY:
        print(f"• {a['name']:<15} | {a['title']}")
        print(f"  Description: {a['description']}")
        print(f"  Env Binding: {a['env_var']}={a['default_endpoint']}")
        print("-" * 60)

def status_agents():
    print("============================================================")
    print("           GenixBit OS Agent Ecosystem Status               ")
    print("============================================================")
    is_online, proxy_info = check_proxy_health()
    if is_online:
        print(f"[ONLINE] Local AI Proxy: {PROXY_URL} (v{proxy_info.get('version', '1.0.0')})")
        print(f"         Hardware Mode: {proxy_info.get('hardware', {}).get('accelerator_type', 'CPU')}")
    else:
        print(f"[OFFLINE] Local AI Proxy ({PROXY_URL}): unreachable ({proxy_info})")
        print("          Start service with: sudo systemctl start genixbit-ai-proxy")
    print("-" * 60)

    print("Detected Agent CLI Toolchains & IDEs:")
    for a in AGENTS_REGISTRY:
        bin_found = shutil.which(a["binary"]) is not None
        cfg_found = os.path.exists(os.path.expanduser(a["config_path"]))
        status_label = "[INSTALLED]" if (bin_found or cfg_found) else "[READY FOR SETUP]"
        print(f"  {status_label:<18} {a['name']:<14} | Binary: {'Found' if bin_found else 'Not in PATH'} | Config: {'Found' if cfg_found else 'Not initialized'}")
    print("============================================================")

def inspect_agent(agent_name):
    target = next((a for a in AGENTS_REGISTRY if a["name"].lower() == agent_name.lower()), None)
    if not target:
        print(f"[ERROR] Agent '{agent_name}' not found in registry. Run 'genixbit-agent list' to view available agents.")
        return 1

    print("============================================================")
    print(f"           Agent Profile: {target['title']}                 ")
    print("============================================================")
    print(f"Name:             {target['name']}")
    print(f"Description:      {target['description']}")
    print(f"Expected Binary:  {target['binary']}")
    print(f"Config Directory: {os.path.expanduser(target['config_path'])}")
    print("\nRecommended Environment Variables:")
    print(f"  export {target['env_var']}=\"{target['default_endpoint']}\"")
    print(f"  export OPENAI_API_KEY=\"genixbit-local-token\"")
    print("\nQuick Start Command:")
    print(f"  {target['env_var']}=\"{target['default_endpoint']}\" {target['binary']}")
    print("============================================================")
    return 0

def doctor():
    print("============================================================")
    print("           GenixBit OS AI Agent Diagnostics (Doctor)        ")
    print("============================================================")
    # Check 1: Python environment
    print(f"[PASS] Python Interpreter: {sys.version.split()[0]} ({sys.executable})")

    # Check 2: Proxy connectivity
    is_online, proxy_info = check_proxy_health()
    if is_online:
        print(f"[PASS] Local AI Proxy: ONLINE at {PROXY_URL}")
    else:
        print(f"[WARN] Local AI Proxy: OFFLINE. Run 'sudo systemctl start genixbit-ai-proxy' or 'genixbit-ai-proxy &'")

    # Check 3: GPU Diagnostics tool
    if shutil.which("genixbit-gpu-diag"):
        print("[PASS] Hardware Diagnostic Tool: genixbit-gpu-diag present")
    else:
        print("[INFO] genixbit-gpu-diag not in PATH (packaged in genixbit-os-gpu-diagnostics)")

    # Check 4: System Memory
    try:
        with open("/proc/meminfo") as f:
            mem_total = 0
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total = int(line.split()[1]) // 1024
            if mem_total >= 8192:
                print(f"[PASS] System RAM: {mem_total}MB (Meets 8GB minimum recommended for 7B models)")
            else:
                print(f"[WARN] System RAM: {mem_total}MB (Recommend 8GB+ for local 7B instruction models)")
    except Exception:
        print("[INFO] Memory check skipped (non-Linux procfs)")

    print("============================================================")
    print("Doctor Status: ALL ESSENTIAL CHECKS VERIFIED")
    print("============================================================")

def get_embedding(text):
    """Compute embedding vector using local proxy or deterministic hash vector."""
    try:
        payload = json.dumps({"input": text, "model": "genixbit-embeddings"}).encode("utf-8")
        req = urllib.request.Request(
            f"{PROXY_URL}/v1/embeddings",
            data=payload,
            headers={"Content-Type": "application/json", "User-Agent": "genixbit-agent/1.0"}
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["data"][0]["embedding"]
    except Exception:
        # Fallback local term frequency vector
        vec = [0.0] * 32
        for i, word in enumerate(text.lower().split()):
            idx = sum(ord(c) for c in word) % 32
            vec[idx] += 1.0
        norm = math.sqrt(sum(v*v for v in vec)) or 1.0
        return [v / norm for v in vec]

def cosine_similarity(v1, v2):
    dot = sum(a * b for a, b in zip(v1, v2))
    norm1 = math.sqrt(sum(a * a for a in v1)) or 1.0
    norm2 = math.sqrt(sum(b * b for b in v2)) or 1.0
    return dot / (norm1 * norm2)

def index_codebase(target_dir):
    target_dir = os.path.abspath(target_dir)
    print(f"[INFO] Indexing codebase in: {target_dir}")
    extensions = ("*.py", "*.sh", "*.json", "*.md", "*.c", "*.h", "*.js", "*.html")
    files_to_index = []
    for ext in extensions:
        files_to_index.extend(glob.glob(os.path.join(target_dir, "**", ext), recursive=True))

    # Filter out hidden or build paths
    files_to_index = [f for f in files_to_index if not any(p in f for p in (".git", ".tmp", "build-debs", "__pycache__"))]
    print(f"[INFO] Found {len(files_to_index)} candidate source files.")

    index_data = []
    for fpath in files_to_index[:100]: # Index first 100 files
        try:
            with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
                # Split into 20-line chunks
                lines = content.splitlines()
                for i in range(0, len(lines), 20):
                    chunk = "\n".join(lines[i:i+20])
                    if chunk.strip():
                        vec = get_embedding(chunk[:500])
                        rel_path = os.path.relpath(fpath, target_dir)
                        index_data.append({
                            "file": rel_path,
                            "start_line": i + 1,
                            "snippet": chunk[:300],
                            "vector": vec
                        })
        except Exception:
            pass

    out_dir = os.path.join(target_dir, ".genixbit")
    os.makedirs(out_dir, exist_ok=True)
    out_file = os.path.join(out_dir, "code-index.json")
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(index_data, f)

    print(f"[PASS] Successfully indexed {len(index_data)} chunks into {out_file}")

def search_codebase(query, target_dir="."):
    index_file = os.path.join(os.path.abspath(target_dir), ".genixbit", "code-index.json")
    if not os.path.exists(index_file):
        print(f"[INFO] No index found at {index_file}. Creating index first...")
        index_codebase(target_dir)

    try:
        with open(index_file, "r", encoding="utf-8") as f:
            index_data = json.load(f)
    except Exception as e:
        print(f"[ERROR] Failed to read index: {e}")
        return 1

    query_vec = get_embedding(query)
    scores = []
    for item in index_data:
        sim = cosine_similarity(query_vec, item["vector"])
        scores.append((sim, item))

    scores.sort(key=lambda x: x[0], reverse=True)
    top_results = scores[:5]

    print("============================================================")
    print(f"     Semantic Code Search Results for: '{query}'            ")
    print("============================================================")
    if not top_results:
        print("No matching code chunks found.")
    else:
        for rank, (score, item) in enumerate(top_results, 1):
            print(f"[{rank}] Score: {score:.3f} | {item['file']}:{item['start_line']}")
            print(f"    {item['snippet'].replace(chr(10), ' ')[:120]}...")
            print("-" * 60)
    return 0

def main():
    parser = argparse.ArgumentParser(description="GenixBit OS Developer Agents Integration CLI")
    parser.add_argument("command", choices=["list", "status", "doctor", "inspect", "index", "search"], help="Command to execute")
    parser.add_argument("argument", nargs="?", default=None, help="Agent name for 'inspect', path for 'index', or query for 'search'")
    args = parser.parse_args()

    if args.command == "list":
        list_agents()
    elif args.command == "status":
        status_agents()
    elif args.command == "doctor":
        doctor()
    elif args.command == "inspect":
        if not args.argument:
            print("[ERROR] Please specify an agent name to inspect. Example: genixbit-agent inspect antigravity")
            sys.exit(1)
        sys.exit(inspect_agent(args.argument))
    elif args.command == "index":
        target = args.argument or "."
        index_codebase(target)
    elif args.command == "search":
        query = args.argument or "proxy server endpoint"
        sys.exit(search_codebase(query))

if __name__ == "__main__":
    main()
