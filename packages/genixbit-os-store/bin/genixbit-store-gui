        .app-title span { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .app-desc { font-size: 13px; color: var(--muted); line-height: 1.4; flex: 1; }
        
        .btn-install { background: var(--accent-gradient); color: #fff; border: none; border-radius: 10px; padding: 9px 16px; font-weight: 600; font-size: 13px; cursor: pointer; transition: opacity 150ms; }
        .btn-install.installed { background: rgba(34, 197, 94, 0.15); color: var(--green); border: 1px solid rgba(34, 197, 94, 0.4); cursor: default; }
    </style>
</head>
<body>
    <header>
        <div class="logo-box">
            <div style="width:28px; height:28px; border-radius:8px; background:var(--accent-gradient); display:flex; align-items:center; justify-content:center; font-weight:bold; color:#fff;">G</div>
            <h1>GenixBit App Store</h1>
        </div>
        <div class="nav-tabs">
            <button class="tab-btn active" onclick="filterCat('all', this)">All</button>
            <button class="tab-btn" onclick="filterCat('dev', this)">Developer</button>
            <button class="tab-btn" onclick="filterCat('ai', this)">AI Models</button>
            <button class="tab-btn" onclick="filterCat('agents', this)">Agents</button>
            <button class="tab-btn" onclick="filterCat('media', this)">Media</button>
            <button class="tab-btn" onclick="filterCat('sys', this)">System</button>
        </div>
    </header>

    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search developer tools, AI models, Flatpaks, or agent workflows..." oninput="renderApps()">
    </div>

    <div class="grid" id="appsGrid"></div>

    <script>
        let currentCat = 'all';
        const apps = %APPS_JSON%;

        function filterCat(cat, btn) {
            currentCat = cat;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderApps();
        }

        function renderApps() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const grid = document.getElementById('appsGrid');
            grid.innerHTML = '';

            const filtered = apps.filter(app => {
                const matchesCat = currentCat === 'all' || app.cat === currentCat;
                const matchesQuery = app.name.toLowerCase().includes(query) || app.desc.toLowerCase().includes(query);
                return matchesCat && matchesQuery;
            });

            filtered.forEach(app => {
                const card = document.createElement('div');
                card.className = 'app-card';
                card.innerHTML = `
                    <div class="app-top">
                        <div class="app-icon">${app.icon}</div>
                        <div class="app-title">
                            <h3>${app.name}</h3>
                            <span>${app.cat.toUpperCase()}</span>
                        </div>
                    </div>
                    <div class="app-desc">${app.desc}</div>
                    <button class="btn-install ${app.installed ? 'installed' : ''}" onclick="installApp('${app.id}', this)">
                        ${app.installed ? '✓ Installed' : 'Install'}
                    </button>
                `;
                grid.appendChild(card);
            });
        }

        function installApp(id, btn) {
            if (btn.classList.contains('installed')) return;
            btn.textContent = 'Installing...';
            btn.style.opacity = '0.7';
            setTimeout(() => {
                btn.textContent = '✓ Installed';
                btn.classList.add('installed');
                btn.style.opacity = '1';
            }, 800);
        }

        renderApps();
    </script>
</body>
</html>
"""

class StoreHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        html = HTML_INTERFACE.replace("%APPS_JSON%", json.dumps(APPS_DATA))
        self.wfile.write(html.encode("utf-8"))

    def log_message(self, format, *args):
        pass

def main():
    parser = argparse.ArgumentParser(description="GenixBit OS App Store Desktop GUI")
    parser.add_argument("--port", type=int, default=GUI_PORT, help="Port to run GUI server on")
    parser.add_argument("--no-browser", action="store_true", help="Do not auto-launch web browser")
    args = parser.parse_args()

    port = args.port
    server = None
    for attempt in range(5):
        try:
            server = socketserver.TCPServer(("127.0.0.1", port), StoreHandler)
            break
        except OSError:
            port += 1

    if not server:
        print(f"[ERROR] Could not bind GenixBit Store GUI to port {args.port} or next 5 ports.")
        sys.exit(1)

    url = f"http://127.0.0.1:{port}"
    print(f"[GenixBit App Store] GUI Active at {url}")

    if not args.no_browser:
        threading.Thread(target=lambda: (time.sleep(0.4), webbrowser.open(url)), daemon=True).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[GenixBit App Store] Stopped.")
        server.server_close()

if __name__ == "__main__":
    main()
