#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# GenixBit OS Desktop Setup & macOS Cyber Layout Provisioner
# Configures authentic macOS Top Menu Bar & Traffic Light Window Controls (🔴 🟡 🟢):
# - Left: [G] System Menu + App Menus (File, Edit, View, AI, Window, Help)
# - Center: Centered Clock (%a, %b %d, %I:%M %p)
# - Right: Quick Action Launchers (✨ AI Assistant, 🔍 Spotlight, 🎛️ Control Center) & Systray
# - Bottom: Centered Floating Frosted Glass Dock with glowing active indicator dots

set -Eeuo pipefail

WALLPAPER_PATH="/usr/share/backgrounds/genixbit/genixbit-wallpaper-dark.png"
THEME_NAME="GenixBit-Dark"
ICON_THEME="GenixBit-Icons"
FONT_NAME="Ubuntu 11"

echo "[GenixBit Desktop Setup] Initializing GenixBit OS macOS Cyber Workstation layout..."

# 1. GNOME Desktop GSettings
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "${THEME_NAME}" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "${ICON_THEME}" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface font-name "${FONT_NAME}" 2>/dev/null || true
    if [[ -f "$WALLPAPER_PATH" ]]; then
        gsettings set org.gnome.desktop.background picture-uri "file://${WALLPAPER_PATH}" 2>/dev/null || true
        gsettings set org.gnome.desktop.background picture-uri-dark "file://${WALLPAPER_PATH}" 2>/dev/null || true
    fi
fi

# 2. XFCE4 / X11 Desktop Configuration (xfconf-query)
if command -v xfconf-query &>/dev/null; then
    # Set Theme & Icons & Font
    xfconf-query -c xsettings -p /Net/ThemeName -s "${THEME_NAME}" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "${ICON_THEME}" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Gtk/FontName -s "${FONT_NAME}" --create -t string 2>/dev/null || true
    
    # Set Deep Cyber Midnight Radial Wallpaper
    if [[ -f "$WALLPAPER_PATH" ]]; then
        for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "${WALLPAPER_PATH}" 2>/dev/null || true
        done
        for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "image-path" || true); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "${WALLPAPER_PATH}" 2>/dev/null || true
        done
    fi

    # Set Window Manager Theme & macOS Traffic Light Controls (🔴 🟡 🟢)
    xfconf-query -c xfwm4 -p /general/theme -s "${THEME_NAME}" --create -t string 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/button_layout -s "CHM|" --create -t string 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/button_spacing -s 6 --create -t int 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/use_compositing -s "true" --create -t bool 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/show_frame_shadow -s "true" --create -t bool 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/show_popup_shadow -s "true" --create -t bool 2>/dev/null || true

    # Docked macOS Top Menu Bar (Panel 1) - 28px Sleek Height
    xfconf-query -c xfce4-panel -p /panels/panel-1/position -s "p=6;x=0;y=0" --create -t string 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 28 --create -t int 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/length -s 100 --create -t int 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/span-monitors -s true --create -t bool 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/autohide-behavior -s 0 --create -t int 2>/dev/null || true

    # Whisker Menu configured as Apple-Style "[G] GenixBit" System Menu
    xfconf-query -c xfce4-panel -p /plugins/plugin-1/button-title -s "GenixBit" --create -t string 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /plugins/plugin-1/button-icon -s "genixbit-mark" --create -t string 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /plugins/plugin-1/show-button-title -s true --create -t bool 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /plugins/plugin-1/show-button-icon -s true --create -t bool 2>/dev/null || true

    # Centered Clock Format (%a, %b %d, %I:%M %p)
    xfconf-query -c xfce4-panel -p /plugins/plugin-6/digital-format -s "%a, %b %d, %I:%M %p" --create -t string 2>/dev/null || true
fi

# 3. Centered Floating Glass Bottom Dock (Position=3)
PLANK_CONFIG_DIR="${HOME}/.config/plank/dock1"
mkdir -p "$PLANK_CONFIG_DIR"
cat <<EOF > "$PLANK_CONFIG_DIR/settings"
[PlankDockPreferences]
Alignment=3
AutoPinning=true
CurrentWorkspaceOnly=false
DockItems=genixbit-ai-center.dockitem;;xfce4-terminal.dockitem;;genixbit-store.dockitem;;genixbit-agent.dockitem;;genixbit-control-center.dockitem;;
HideDelay=0
HideMode=1
IconSize=48
ItemMoveTime=300
LockItems=false
Monitor=
Offset=0
PinnedOnly=false
Position=3
PressureReveal=false
ShowDockItem=false
Theme=GenixBit-Glass
ZoomEnabled=true
ZoomPercent=130
EOF

# Create Dock Launchers
mkdir -p "$PLANK_CONFIG_DIR/launchers"
cat <<EOF > "$PLANK_CONFIG_DIR/launchers/genixbit-ai-center.dockitem"
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/genixbit-ai-center.desktop
EOF
cat <<EOF > "$PLANK_CONFIG_DIR/launchers/xfce4-terminal.dockitem"
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/xfce4-terminal.desktop
EOF
cat <<EOF > "$PLANK_CONFIG_DIR/launchers/genixbit-store.dockitem"
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/genixbit-store.desktop
EOF
cat <<EOF > "$PLANK_CONFIG_DIR/launchers/genixbit-agent.dockitem"
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/genixbit-agent.desktop
EOF
cat <<EOF > "$PLANK_CONFIG_DIR/launchers/genixbit-control-center.dockitem"
[PlankDockItemPreferences]
Launcher=file:///usr/share/applications/genixbit-control-center.desktop
EOF

# 4. Clean up Desktop Icons (AI Center, Terminal, App Store, Agents)
DESKTOP_DIR="${HOME}/Desktop"
mkdir -p "$DESKTOP_DIR"
cat <<EOF > "$DESKTOP_DIR/genixbit-ai-center.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=AI Center
Comment=GenixBit OS AI Center
Exec=genixbit-ai-center-gui
Icon=genixbit-ai-center
Terminal=false
Categories=Utility;Development;
EOF

cat <<EOF > "$DESKTOP_DIR/xfce4-terminal.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Terminal
Comment=GenixBit Terminal
Exec=xfce4-terminal
Icon=xfce4-terminal
Terminal=false
Categories=System;TerminalEmulator;
EOF

cat <<EOF > "$DESKTOP_DIR/genixbit-store.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=App Store
Comment=GenixBit App Store
Exec=genixbit-store
Icon=genixbit-store
Terminal=false
Categories=Utility;PackageManager;
EOF

cat <<EOF > "$DESKTOP_DIR/genixbit-agent.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Agents
Comment=GenixBit Multi-Agent Orchestrator
Exec=genixbit-swarm
Icon=genixbit-agent
Terminal=false
Categories=Development;
EOF

chmod +x "$DESKTOP_DIR"/*.desktop 2>/dev/null || true

# 5. Autostart macOS Top Menu Bar
AUTOSTART_DIR="${HOME}/.config/autostart"
mkdir -p "$AUTOSTART_DIR"
cat <<EOF > "$AUTOSTART_DIR/genixbit-topbar.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=GenixBit Top Bar
Comment=macOS Style Top Menu Bar
Exec=genixbit-topbar
Terminal=false
StartupNotify=false
EOF

# Kill any existing topbar and launch in background if DISPLAY is active
if [[ -n "${DISPLAY:-}" ]]; then
    pkill -f genixbit-macos-topbar.py 2>/dev/null || true
    (genixbit-topbar &>/dev/null &) || true
fi

echo "[GenixBit Desktop Setup] GenixBit OS macOS Cyber layout successfully configured."
