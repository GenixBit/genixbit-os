#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# GenixBit OS Desktop Setup & Layout Provisioner
# Applies macOS-style top bar + floating bottom dock, sets GenixBit-Dark theme,
# applies official wallpaper, and cleans up desktop clutter.

set -Eeuo pipefail

WALLPAPER_PATH="/usr/share/backgrounds/genixbit/genixbit-wallpaper-dark.png"
THEME_NAME="GenixBit-Dark"
ICON_THEME="Adwaita"
FONT_NAME="Inter 11"

echo "[GenixBit Desktop Setup] Initializing desktop environment..."

# 1. GNOME Desktop GSettings
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "${THEME_NAME}" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface font-name "${FONT_NAME}" 2>/dev/null || true
    if [[ -f "$WALLPAPER_PATH" ]]; then
        gsettings set org.gnome.desktop.background picture-uri "file://${WALLPAPER_PATH}" 2>/dev/null || true
        gsettings set org.gnome.desktop.background picture-uri-dark "file://${WALLPAPER_PATH}" 2>/dev/null || true
    fi
fi

# 2. XFCE4 / X11 Desktop Configuration (xfconf-query)
if command -v xfconf-query &>/dev/null; then
    # Set Theme & Font
    xfconf-query -c xsettings -p /Net/ThemeName -s "${THEME_NAME}" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "${ICON_THEME}" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Gtk/FontName -s "${FONT_NAME}" --create -t string 2>/dev/null || true
    
    # Set Dark Wallpaper
    if [[ -f "$WALLPAPER_PATH" ]]; then
        for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "last-image" || true); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "${WALLPAPER_PATH}" 2>/dev/null || true
        done
        for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep "image-path" || true); do
            xfconf-query -c xfce4-desktop -p "$prop" -s "${WALLPAPER_PATH}" 2>/dev/null || true
        done
    fi

    # Set Window Manager Theme
    xfconf-query -c xfwm4 -p /general/theme -s "${THEME_NAME}" --create -t string 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/button_layout -s "CHM|" --create -t string 2>/dev/null || true
fi

# 3. Clean up desktop icon clutter (keep only AI Center, Terminal, and Files)
DESKTOP_DIR="${HOME}/Desktop"
if [[ -d "$DESKTOP_DIR" ]]; then
    mkdir -p "$DESKTOP_DIR"
    # Ensure clean standard launchers exist without duplicate overlapping shortcuts
    if [[ -f "/usr/share/applications/genixbit-ai-center.desktop" ]]; then
        cp -f "/usr/share/applications/genixbit-ai-center.desktop" "$DESKTOP_DIR/" 2>/dev/null || true
        chmod +x "$DESKTOP_DIR/genixbit-ai-center.desktop" 2>/dev/null || true
    fi
fi

echo "[GenixBit Desktop Setup] Desktop environment successfully configured."
