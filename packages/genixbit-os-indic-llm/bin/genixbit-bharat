# GenixBit OS — genixbit-bharat CLI
import argparse
import json
import os
import sys

for p in ["/usr/lib/genixbit-os", os.path.join(os.path.dirname(__file__), "../usr/lib/genixbit-os")]:
    if os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

import bharat_ai

def main():
    parser = argparse.ArgumentParser(description="GenixBit Bharat AI — 22 Indian Languages Engine")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # list
    list_p = subparsers.add_parser("list", help="List all 22 official supported Indian languages")
    list_p.add_argument("--json", action="store_true", help="Output as JSON")

    # translate
    tr_p = subparsers.add_parser("translate", help="Translate / normalize prompts between languages")
    tr_p.add_argument("--src", default="hi", help="Source language code (default: hi)")
    tr_p.add_argument("--tgt", default="en", help="Target language code (default: en)")
    tr_p.add_argument("text", nargs="*", help="Text to translate")

    # info
    info_p = subparsers.add_parser("info", help="Get language details by code or name")
    info_p.add_argument("lang", help="Language code or name (e.g. mr, hi, ta)")

    args = parser.parse_args()

    if args.command == "list" or not args.command:
        langs = bharat_ai.list_languages()
        if getattr(args, "json", False):
            print(json.dumps({"languages": langs}, indent=2, ensure_ascii=False))
        else:
            print(f"GenixBit Bharat AI — Supported 22 Official Indian Languages ({len(langs)} total):\n")
            print(f"{'Code':<6} {'Name':<22} {'Native Script':<20} {'Script Type'}")
            print("-" * 65)
            for l in langs:
                print(f"{l['code']:<6} {l['name']:<22} {l['native']:<20} {l['script']}")
    elif args.command == "info":
        info = bharat_ai.get_language_info(args.lang)
        if info:
            print(json.dumps(info, indent=2, ensure_ascii=False))
        else:
            print(f"Error: Language '{args.lang}' not recognized.", file=sys.stderr)
            sys.exit(1)
    elif args.command == "translate":
        text = " ".join(args.text)
        if not text:
            print("Error: Please provide text to translate.", file=sys.stderr)
            sys.exit(1)
        res = bharat_ai.translate_mock(text, args.src, args.tgt)
        print(json.dumps(res, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()
